                },
                "responses": {
                    "200": {
                        "description": "Pago procesado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PaymentResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "La orden ya fue pagada",
